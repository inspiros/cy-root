from collections.abc import Iterator
from typing import Any
from .status import TerminationReason

__all__ = ['RootReturnType', 'BracketingMethodsReturnType', 'NewtonMethodsReturnType', 'MultiRootsReturnType', 'SplittingBracketingMethodsReturnType', 'SplittingNewtonMethodsReturnType']

class RootReturnType:
    def __init__(self, root: Any = ..., f_root: Any = ..., iters: Any = ..., f_calls: Any = ..., precision: Any = ..., error: Any = ..., converged: Any = ..., optimal: Any = ..., termination_reason: Any = ...) -> None: ...
    @property
    def root(self) -> Any: ...
    @property
    def f_root(self) -> Any: ...
    @property
    def iters(self) -> int: ...
    @property
    def f_calls(self) -> int | tuple[int, ...]: ...
    @property
    def precision(self) -> float: ...
    @property
    def error(self) -> float: ...
    @property
    def converged(self) -> bool: ...
    @property
    def optimal(self) -> bool: ...
    @property
    def termination_reason(self) -> TerminationReason: ...
    @property
    def success(self) -> bool: ...
    def __getitem__(self, i: int) -> Any: ...
    def __iter__(self) -> Iterator[Any]: ...

class BracketingMethodsReturnType(RootReturnType):
    def __init__(self, root: Any = ..., f_root: Any = ..., iters: Any = ..., f_calls: Any = ..., bracket: Any = ..., f_bracket: Any = ..., precision: Any = ..., error: Any = ..., converged: Any = ..., optimal: Any = ..., termination_reason: Any = ...) -> None: ...
    @property
    def bracket(self) -> Any: ...
    @property
    def f_bracket(self) -> Any: ...

class NewtonMethodsReturnType(RootReturnType):
    def __init__(self, root: Any = ..., f_root: Any = ..., df_root: Any = ..., iters: Any = ..., f_calls: Any = ..., precision: Any = ..., error: Any = ..., converged: Any = ..., optimal: Any = ..., termination_reason: Any = ...) -> None: ...
    @property
    def df_root(self) -> Any: ...

class MultiRootsReturnType:
    def __init__(self, root: Any = ..., f_root: Any = ..., split_iters: Any = ..., iters: Any = ..., f_calls: Any = ..., precision: Any = ..., error: Any = ..., converged: Any = ..., optimal: Any = ..., termination_reasons: Any = ..., search_termination_reason: Any = ...) -> None: ...
    @property
    def root(self) -> list[Any]: ...
    @property
    def f_root(self) -> list[Any]: ...
    @property
    def split_iters(self) -> int: ...
    @property
    def iters(self) -> list[int]: ...
    @property
    def f_calls(self) -> int | tuple[int, ...]: ...
    @property
    def precision(self) -> list[float]: ...
    @property
    def error(self) -> list[float]: ...
    @property
    def converged(self) -> list[bool]: ...
    @property
    def optimal(self) -> list[bool]: ...
    @property
    def termination_reasons(self) -> list[TerminationReason]: ...
    @property
    def search_termination_reason(self) -> TerminationReason: ...
    @property
    def success(self) -> bool: ...
    def __getitem__(self, i: int) -> Any: ...
    def __iter__(self) -> Iterator[Any]: ...

class SplittingBracketingMethodsReturnType(MultiRootsReturnType):
    def __init__(self, root: Any = ..., f_root: Any = ..., split_iters: Any = ..., iters: Any = ..., f_calls: Any = ..., bracket: Any = ..., f_bracket: Any = ..., precision: Any = ..., error: Any = ..., converged: Any = ..., optimal: Any = ..., termination_reasons: Any = ..., search_termination_reason: Any = ...) -> None: ...
    @property
    def bracket(self) -> list[Any]: ...
    @property
    def f_bracket(self) -> list[Any]: ...

class SplittingNewtonMethodsReturnType(MultiRootsReturnType):
    def __init__(self, root: Any = ..., f_root: Any = ..., df_root: Any = ..., split_iters: Any = ..., iters: Any = ..., f_calls: Any = ..., precision: Any = ..., error: Any = ..., converged: Any = ..., optimal: Any = ..., termination_reasons: Any = ..., search_termination_reason: Any = ...) -> None: ...
    @property
    def df_root(self) -> list[Any]: ...

def _normalize_reason(reason: Any) -> TerminationReason: ...
def _successful(reason: Any) -> bool: ...
