from typing import SupportsFloat

class ScalarDerivativePlan:
    def __init__(self, scheme: str = ..., step: SupportsFloat | None = ...) -> None: ...
    @property
    def scheme(self) -> str: ...
    @property
    def step(self) -> float | None: ...
    @property
    def sample_count(self) -> int: ...

class ScalarSecondDerivativePlan:
    def __init__(self, scheme: str = ..., step: SupportsFloat | None = ...) -> None: ...
    @property
    def scheme(self) -> str: ...
    @property
    def step(self) -> float | None: ...
    @property
    def sample_count(self) -> int: ...
