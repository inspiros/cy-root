from typing import Any, SupportsIndex
from numpy.typing import ArrayLike

class HessianCallback:
    def __init__(self, function: Any, dimension: SupportsIndex) -> None: ...
    @classmethod
    def from_capsule(cls, capsule: Any, keepalive: Any = ...) -> HessianCallback: ...
    @property
    def native(self) -> bool: ...
    @property
    def dimension(self) -> int: ...

class RectangularHessianCallback:
    def __init__(self, function: Any, input_dimension: SupportsIndex,
                 output_dimension: SupportsIndex) -> None: ...
    @classmethod
    def from_capsule(cls, capsule: Any, keepalive: Any = ...) -> RectangularHessianCallback: ...
    def evaluate(self, point: ArrayLike, *,
                 workspace_bytes: SupportsIndex = ...) -> tuple[tuple[tuple[float, ...], ...], ...]: ...
    @property
    def input_dimension(self) -> int: ...
    @property
    def output_dimension(self) -> int: ...
    @property
    def shape(self) -> tuple[int, int, int]: ...
    @property
    def native(self) -> bool: ...
