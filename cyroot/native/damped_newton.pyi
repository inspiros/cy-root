from typing import Any, SupportsFloat, SupportsIndex
from collections.abc import Iterator
from numpy.typing import ArrayLike
from .scalar import NewtonStep
from .vector import VectorNewtonStep
from ..return_types import NewtonMethodsReturnType

class DampedNewton(Iterator[NewtonStep]):
    def __init__(self, function: Any, derivative: Any, x0: SupportsFloat,
                 f_x0: SupportsFloat | None = ..., df_x0: SupportsFloat | None = ..., *,
                 c1: SupportsFloat = ..., contraction: SupportsFloat = ...,
                 max_line_search: SupportsIndex = ..., **options: Any) -> None: ...
    def step(self) -> NewtonStep: ...
    def run(self) -> NewtonMethodsReturnType: ...
    def __iter__(self) -> DampedNewton: ...
    def __next__(self) -> NewtonStep: ...
    @property
    def result(self) -> NewtonMethodsReturnType: ...
    @property
    def done(self) -> bool: ...
    @property
    def history(self) -> tuple[NewtonStep, ...]: ...
    @property
    def history_truncated(self) -> bool: ...
    @property
    def step_scale(self) -> float: ...
    @property
    def backtracks(self) -> int: ...
    @property
    def callback_code(self) -> int: ...
    @property
    def callback_stage(self) -> str | None: ...

class VectorDampedNewton(Iterator[VectorNewtonStep]):
    def __init__(self, function: Any, jacobian: Any, x0: ArrayLike,
                 f_x0: ArrayLike | None = ..., jac_x0: ArrayLike | None = ..., *,
                 c1: SupportsFloat = ..., contraction: SupportsFloat = ...,
                 max_line_search: SupportsIndex = ..., **options: Any) -> None: ...
    def step(self) -> VectorNewtonStep: ...
    def run(self) -> NewtonMethodsReturnType: ...
    def __iter__(self) -> VectorDampedNewton: ...
    def __next__(self) -> VectorNewtonStep: ...
    @property
    def result(self) -> NewtonMethodsReturnType: ...
    @property
    def done(self) -> bool: ...
    @property
    def history(self) -> tuple[VectorNewtonStep, ...]: ...
    @property
    def history_truncated(self) -> bool: ...
    @property
    def step_scale(self) -> float: ...
    @property
    def backtracks(self) -> int: ...
    @property
    def callback_code(self) -> int: ...
    @property
    def callback_stage(self) -> str | None: ...
    @property
    def linear_status(self) -> int: ...
    @property
    def linear_rank(self) -> int | None: ...

def damped_newton(function: Any, derivative: Any, x0: SupportsFloat,
                  **options: Any) -> NewtonMethodsReturnType: ...
def vector_damped_newton(function: Any, jacobian: Any, x0: ArrayLike,
                         **options: Any) -> NewtonMethodsReturnType: ...
