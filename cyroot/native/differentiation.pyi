from typing import Any, NamedTuple, SupportsFloat, SupportsIndex
from numpy.typing import ArrayLike

__all__ = ['AdaptiveHessian', 'NumericalHessianEstimate', 'AdaptiveSecondDerivative', 'ComplexStepDerivative', 'ComplexStepJacobian', 'AdaptiveDerivative',
           'AdaptiveJacobian', 'ComplexVectorCallback', 'DerivativeEstimate',
           'NumericalJacobianEstimate', 'DifferentiationError']

class DerivativeEstimate(NamedTuple):
    derivative: float
    error: float | None
    f_calls: int
    status: str
    callback_code: int

class NumericalJacobianEstimate(NamedTuple):
    jacobian: tuple[tuple[float, ...], ...]
    error: tuple[tuple[float, ...], ...] | None
    f_calls: int
    status: str
    callback_code: int

class NumericalHessianEstimate(NamedTuple):
    hessian: tuple[tuple[tuple[float, ...], ...], ...]
    error: tuple[tuple[tuple[float, ...], ...], ...]
    f_calls: int
    status: str
    callback_code: int

class DifferentiationError(ArithmeticError):
    estimate: DerivativeEstimate | NumericalJacobianEstimate | NumericalHessianEstimate
    def __init__(self, estimate: DerivativeEstimate | NumericalJacobianEstimate | NumericalHessianEstimate) -> None: ...

class _ScalarDifferentiation:
    def __call__(self, x: SupportsFloat) -> float: ...
    def evaluate(self, x: SupportsFloat) -> DerivativeEstimate: ...
    @property
    def native(self) -> bool: ...
    @property
    def last_estimate(self) -> DerivativeEstimate: ...
    @property
    def step(self) -> float | None: ...
    @property
    def max_steps(self) -> int | None: ...
    @property
    def order(self) -> int: ...

class ComplexStepDerivative(_ScalarDifferentiation):
    def __init__(self, function: Any, *, step: SupportsFloat | None = ...) -> None: ...

class AdaptiveDerivative(_ScalarDifferentiation):
    def __init__(self, function: Any, *, step: SupportsFloat | None = ...,
                 atol: SupportsFloat = ..., rtol: SupportsFloat = ...,
                 max_steps: SupportsIndex = ...) -> None: ...

class AdaptiveSecondDerivative(_ScalarDifferentiation):
    def __init__(self, function: Any, *, step: SupportsFloat | None = ...,
                 atol: SupportsFloat = ..., rtol: SupportsFloat = ...,
                 max_steps: SupportsIndex = ...) -> None: ...

class _JacobianDifferentiation:
    def __call__(self, x: ArrayLike) -> tuple[tuple[float, ...], ...]: ...
    def evaluate(self, x: ArrayLike, *, workspace_bytes: SupportsIndex | None = ...) -> NumericalJacobianEstimate: ...
    @property
    def native(self) -> bool: ...
    @property
    def last_estimate(self) -> NumericalJacobianEstimate: ...
    @property
    def input_dimension(self) -> int: ...
    @property
    def output_dimension(self) -> int: ...
    @property
    def jacobian(self) -> bool: ...
    @property
    def step(self) -> tuple[float, ...] | None: ...
    @property
    def memory_bytes(self) -> int: ...
    @property
    def max_steps(self) -> int | None: ...

class ComplexStepJacobian(_JacobianDifferentiation):
    def __init__(self, function: Any, input_dimension: SupportsIndex,
                 output_dimension: SupportsIndex, *, step: SupportsFloat | ArrayLike | None = ...,
                 memory_bytes: SupportsIndex = ...) -> None: ...

class AdaptiveJacobian(_JacobianDifferentiation):
    def __init__(self, function: Any, input_dimension: SupportsIndex,
                 output_dimension: SupportsIndex, *, step: SupportsFloat | ArrayLike | None = ...,
                 atol: SupportsFloat = ..., rtol: SupportsFloat = ...,
                 max_steps: SupportsIndex = ..., memory_bytes: SupportsIndex = ...) -> None: ...

class ComplexVectorCallback:
    def __init__(self, function: Any, input_dimension: SupportsIndex,
                 output_dimension: SupportsIndex) -> None: ...
    @classmethod
    def from_capsule(cls, capsule: Any, keepalive: Any = ...) -> ComplexVectorCallback: ...
    def evaluate(self, point: ArrayLike, *, workspace_bytes: SupportsIndex = ...) -> tuple[complex, ...]: ...
    @property
    def native(self) -> bool: ...
    @property
    def input_dimension(self) -> int: ...
    @property
    def output_dimension(self) -> int: ...

class AdaptiveHessian:
    def __init__(self, function: Any, input_dimension: SupportsIndex,
                 output_dimension: SupportsIndex, *, step: SupportsFloat | ArrayLike | None = ...,
                 atol: SupportsFloat = ..., rtol: SupportsFloat = ...,
                 max_steps: SupportsIndex = ..., memory_bytes: SupportsIndex = ...) -> None: ...
    def __call__(self, x: ArrayLike) -> tuple[tuple[tuple[float, ...], ...], ...]: ...
    def evaluate(self, x: ArrayLike, *, workspace_bytes: SupportsIndex | None = ...) -> NumericalHessianEstimate: ...
    @property
    def native(self) -> bool: ...
    @property
    def last_estimate(self) -> NumericalHessianEstimate: ...
    @property
    def input_dimension(self) -> int: ...
    @property
    def output_dimension(self) -> int: ...
    @property
    def step(self) -> tuple[float, ...] | None: ...
    @property
    def memory_bytes(self) -> int: ...
    @property
    def max_steps(self) -> int: ...
