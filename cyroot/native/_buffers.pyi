from typing import Any, SupportsFloat, SupportsIndex

class DoubleBuffer:
    def __init__(self, source: Any, *, copy: bool = ...) -> None: ...
    def __buffer__(self, flags: int, /) -> memoryview: ...
    def __len__(self) -> int: ...
    def __getitem__(self, key: SupportsIndex | tuple[SupportsIndex, SupportsIndex], /) -> float: ...
    def __setitem__(self, key: SupportsIndex | tuple[SupportsIndex, SupportsIndex],
                    value: SupportsFloat, /) -> None: ...
    def fill(self, value: SupportsFloat) -> None: ...
    def copy(self) -> DoubleBuffer: ...
    def tolist(self) -> list[float] | list[list[float]]: ...
    @property
    def ndim(self) -> int: ...
    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def strides(self) -> tuple[int, ...]: ...
    @property
    def size(self) -> int: ...
    @property
    def readonly(self) -> bool: ...
    @property
    def owns_data(self) -> bool: ...
