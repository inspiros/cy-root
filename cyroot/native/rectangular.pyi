from typing import Any, SupportsIndex
from numpy.typing import ArrayLike

class RectangularCallback:
    def __init__(self, function: Any, input_dimension: SupportsIndex,
                 output_dimension: SupportsIndex, *, jacobian: bool = ...) -> None: ...
    @classmethod
    def from_capsule(cls, capsule: Any, keepalive: Any = ...) -> RectangularCallback: ...
    def evaluate(self, point: ArrayLike, *, workspace_bytes: SupportsIndex = ...
                 ) -> tuple[float, ...] | tuple[tuple[float, ...], ...]: ...
    @property
    def input_dimension(self) -> int: ...
    @property
    def output_dimension(self) -> int: ...
    @property
    def jacobian(self) -> bool: ...
    @property
    def native(self) -> bool: ...
