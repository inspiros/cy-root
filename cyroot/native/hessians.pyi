from typing import Any, NamedTuple, SupportsFloat, SupportsIndex
from numpy.typing import ArrayLike

class HessianEstimate(NamedTuple):
    hessian: tuple[tuple[tuple[float, ...], ...], ...]
    f_calls: int
    status: str
    callback_code: int

class HessianPlan:
    def __init__(self, dimension: SupportsIndex, scheme: str = ...,
                 step: SupportsFloat | ArrayLike | None = ..., *,
                 memory_bytes: SupportsIndex = ...) -> None: ...
    def evaluate(self, function: Any, x: ArrayLike,
                 f_x: ArrayLike | None = ...) -> HessianEstimate: ...
    @property
    def dimension(self) -> int: ...
    @property
    def scheme(self) -> str: ...
    @property
    def step(self) -> tuple[float, ...] | None: ...
    @property
    def shape(self) -> tuple[int, int, int]: ...
    @property
    def sample_count(self) -> int: ...
    @property
    def storage_bytes(self) -> int: ...
    @property
    def workspace_size(self) -> int: ...
    @property
    def workspace_bytes(self) -> int: ...
    @property
    def output_bytes(self) -> int: ...
    @property
    def evaluation_bytes(self) -> int: ...
    @property
    def memory_bytes(self) -> int: ...

class RectangularHessianPlan:
    def __init__(self, input_dimension: SupportsIndex, output_dimension: SupportsIndex,
                 scheme: str = ..., step: SupportsFloat | ArrayLike | None = ..., *,
                 memory_bytes: SupportsIndex = ...) -> None: ...
    def evaluate(self, function: Any, x: ArrayLike,
                 f_x: ArrayLike | None = ...) -> HessianEstimate: ...
    @property
    def input_dimension(self) -> int: ...
    @property
    def output_dimension(self) -> int: ...
    @property
    def scheme(self) -> str: ...
    @property
    def step(self) -> tuple[float, ...] | None: ...
    @property
    def shape(self) -> tuple[int, int, int]: ...
    @property
    def sample_count(self) -> int: ...
    @property
    def storage_bytes(self) -> int: ...
    @property
    def workspace_size(self) -> int: ...
    @property
    def workspace_bytes(self) -> int: ...
    @property
    def output_bytes(self) -> int: ...
    @property
    def evaluation_bytes(self) -> int: ...
    @property
    def memory_bytes(self) -> int: ...
