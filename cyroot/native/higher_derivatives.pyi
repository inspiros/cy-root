from typing import Any, NamedTuple, SupportsFloat, SupportsIndex

class ScalarDerivativeEstimate(NamedTuple):
    derivative: float
    f_calls: int
    status: str
    callback_code: int

class ScalarFiniteDifferencePlan:
    def __init__(self, order: SupportsIndex, scheme: str = ..., step: SupportsFloat | None = ..., *,
                 max_nodes: SupportsIndex = ..., workspace_bytes: SupportsIndex = ...) -> None: ...
    def evaluate(self, function: Any, x: SupportsFloat,
                 f_x: SupportsFloat | None = ...) -> ScalarDerivativeEstimate: ...
    @property
    def order(self) -> int: ...
    @property
    def scheme(self) -> str: ...
    @property
    def step(self) -> float | None: ...
    @property
    def stencil_size(self) -> int: ...
    @property
    def sample_count(self) -> int: ...
    @property
    def workspace_size(self) -> int: ...
    @property
    def workspace_bytes(self) -> int: ...
