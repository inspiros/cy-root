from collections.abc import Iterable, Iterator
from typing import Any, NamedTuple, SupportsFloat, SupportsIndex
from ..status import TerminationReason
from ..return_types import RootReturnType

class InterpolationStep(NamedTuple):
    root: float | complex
    f_root: float | complex
    iters: int
    f_calls: int
    precision: float
    error: float
    termination_reason: TerminationReason | None
    callback_code: int

class _Interpolation:
    def __init__(self, function: Any, points: Iterable[Any], values: Iterable[Any] | None,
                 method: int, aitken: bool = ...,
                 etol: SupportsFloat = ..., ertol: SupportsFloat = ...,
                 ptol: SupportsFloat = ..., prtol: SupportsFloat = ...,
                 max_iter: SupportsIndex = ..., history: SupportsIndex = ...,
                 history_every: SupportsIndex = ..., history_bytes: SupportsIndex = ...,
                 workspace_bytes: SupportsIndex = ...) -> None: ...
    def step(self) -> InterpolationStep: ...
    def run(self) -> RootReturnType: ...
    @property
    def result(self) -> RootReturnType: ...
    @property
    def history(self) -> tuple[InterpolationStep, ...]: ...
    @property
    def done(self) -> bool: ...
    @property
    def history_truncated(self) -> bool: ...
    @property
    def callback_code(self) -> int: ...
    @property
    def callback_stage(self) -> str | None: ...
    def __iter__(self) -> Iterator[InterpolationStep]: ...
    def __next__(self) -> InterpolationStep: ...

class Sidi(_Interpolation):
    def __init__(self, function: Any, x0s: Iterable[SupportsFloat],
                 f_x0s: Iterable[SupportsFloat | None] | None = ..., **options: Any) -> None: ...

class Steffensen(_Interpolation):
    def __init__(self, function: Any, x0: SupportsFloat, f_x0: SupportsFloat | None = ..., *,
                 aitken: bool = ..., **options: Any) -> None: ...

class InverseQuadraticInterpolation(_Interpolation):
    def __init__(self, function: Any, x0: SupportsFloat, x1: SupportsFloat, x2: SupportsFloat,
                 f_x0: SupportsFloat | None = ..., f_x1: SupportsFloat | None = ...,
                 f_x2: SupportsFloat | None = ..., **options: Any) -> None: ...

class HyperbolicInterpolation(_Interpolation):
    def __init__(self, function: Any, x0: SupportsFloat, x1: SupportsFloat, x2: SupportsFloat,
                 f_x0: SupportsFloat | None = ..., f_x1: SupportsFloat | None = ...,
                 f_x2: SupportsFloat | None = ..., **options: Any) -> None: ...

class Muller(_Interpolation):
    def __init__(self, function: Any, x0: complex, x1: complex, x2: complex,
                 f_x0: complex | None = ..., f_x1: complex | None = ...,
                 f_x2: complex | None = ..., **options: Any) -> None: ...

def sidi(function: Any, x0s: Iterable[SupportsFloat], **options: Any) -> RootReturnType: ...
def steffensen(function: Any, x0: SupportsFloat, **options: Any) -> RootReturnType: ...
def inverse_quadratic_interp(function: Any, x0: SupportsFloat, x1: SupportsFloat, x2: SupportsFloat, **options: Any) -> RootReturnType: ...
def hyperbolic_interp(function: Any, x0: SupportsFloat, x1: SupportsFloat, x2: SupportsFloat, **options: Any) -> RootReturnType: ...
def muller(function: Any, x0: complex, x1: complex, x2: complex, **options: Any) -> RootReturnType: ...
