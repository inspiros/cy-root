from collections.abc import Iterator
from typing import Any, NamedTuple, SupportsFloat, SupportsIndex
from ..status import TerminationReason
from ..return_types import BracketingMethodsReturnType

class BracketStep(NamedTuple):
    root: float
    f_root: float
    bracket: tuple[float, float]
    f_bracket: tuple[float, float]
    iters: int
    f_calls: int
    precision: float
    error: float
    termination_reason: TerminationReason | None
    callback_code: int

class BracketSolver:
    def __init__(self, function: Any, a: SupportsFloat, b: SupportsFloat,
                 f_a: SupportsFloat | None = ..., f_b: SupportsFloat | None = ..., *, method: str = ...,
                 etol: SupportsFloat = ..., ertol: SupportsFloat = ...,
                 ptol: SupportsFloat = ..., prtol: SupportsFloat = ...,
                 max_iter: SupportsIndex = ..., history: SupportsIndex = ...,
                 history_every: SupportsIndex = ..., history_bytes: SupportsIndex = ...,
                 interp_method: SupportsIndex | str = ..., sigma: SupportsFloat = ...,
                 k: SupportsFloat = ..., mu: SupportsFloat = ..., k1: SupportsFloat | None = ...,
                 k2: SupportsFloat = ..., n0: SupportsIndex = ...) -> None: ...
    def step(self) -> BracketStep: ...
    def run(self) -> BracketingMethodsReturnType: ...
    @property
    def result(self) -> BracketingMethodsReturnType: ...
    @property
    def history(self) -> tuple[BracketStep, ...]: ...
    @property
    def done(self) -> bool: ...
    @property
    def history_truncated(self) -> bool: ...
    @property
    def callback_code(self) -> int: ...
    @property
    def callback_stage(self) -> str | None: ...
    def __iter__(self) -> Iterator[BracketStep]: ...
    def __next__(self) -> BracketStep: ...

def regula_falsi(function: Any, a: SupportsFloat, b: SupportsFloat, **options: Any) -> BracketingMethodsReturnType: ...
def illinois(function: Any, a: SupportsFloat, b: SupportsFloat, **options: Any) -> BracketingMethodsReturnType: ...
def pegasus(function: Any, a: SupportsFloat, b: SupportsFloat, **options: Any) -> BracketingMethodsReturnType: ...
def anderson_bjorck(function: Any, a: SupportsFloat, b: SupportsFloat, **options: Any) -> BracketingMethodsReturnType: ...
def dekker(function: Any, a: SupportsFloat, b: SupportsFloat, **options: Any) -> BracketingMethodsReturnType: ...
def brent(function: Any, a: SupportsFloat, b: SupportsFloat, **options: Any) -> BracketingMethodsReturnType: ...
def chandrupatla(function: Any, a: SupportsFloat, b: SupportsFloat, **options: Any) -> BracketingMethodsReturnType: ...
def ridders(function: Any, a: SupportsFloat, b: SupportsFloat, **options: Any) -> BracketingMethodsReturnType: ...
def toms748(function: Any, a: SupportsFloat, b: SupportsFloat, **options: Any) -> BracketingMethodsReturnType: ...
def wu(function: Any, a: SupportsFloat, b: SupportsFloat, **options: Any) -> BracketingMethodsReturnType: ...
def itp(function: Any, a: SupportsFloat, b: SupportsFloat, **options: Any) -> BracketingMethodsReturnType: ...
