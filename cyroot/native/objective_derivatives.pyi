from collections.abc import Sequence
from typing import Any, SupportsFloat, SupportsIndex

class ObjectiveDerivativePlan:
    def __init__(self, input_dimension: SupportsIndex, output_dimension: SupportsIndex,
                 order: SupportsIndex, *, max_terms: SupportsIndex = ...,
                 memory_bytes: SupportsIndex = ...) -> None: ...
    def transform(self, tensors: Sequence[Any]) -> tuple[Any, ...]: ...
    def evaluate(self, function: Any, derivatives: Sequence[Any],
                 x: Sequence[SupportsFloat]) -> tuple[Any, ...]: ...
    @property
    def input_dimension(self) -> int: ...
    @property
    def output_dimension(self) -> int: ...
    @property
    def order(self) -> int: ...
    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def term_count(self) -> int: ...
    @property
    def memory_bytes(self) -> int: ...
