from typing import Any, SupportsIndex
from numpy.typing import ArrayLike

class LeastSquaresObjective:
    def __init__(self, function: Any, input_dimension: SupportsIndex,
                 output_dimension: SupportsIndex | None = ..., *, jacobian: Any = ...,
                 hessian: Any = ..., workspace_bytes: SupportsIndex = ...,
                 scalar: bool = ...) -> None: ...
    @classmethod
    def from_scalar(cls, function: Any, *, derivative: Any = ..., second_derivative: Any = ...,
                    workspace_bytes: SupportsIndex = ...) -> LeastSquaresObjective: ...
    def __call__(self, point: ArrayLike) -> float: ...
    def value(self, point: ArrayLike) -> float: ...
    def gradient(self, point: ArrayLike) -> tuple[float, ...]: ...
    def hessian(self, point: ArrayLike) -> tuple[tuple[float, ...], ...]: ...
    def residual(self, point: ArrayLike) -> tuple[float, ...]: ...
    @property
    def input_dimension(self) -> int: ...
    @property
    def output_dimension(self) -> int: ...
    @property
    def memory_bytes(self) -> int: ...
    @property
    def callback_code(self) -> int: ...
    @property
    def callback_stage(self) -> str | None: ...
