from collections.abc import Iterator
from typing import Any, NamedTuple, SupportsFloat, SupportsIndex
from numpy.typing import ArrayLike
from ..status import TerminationReason
from ..return_types import NewtonMethodsReturnType

class VectorChebyshevStep(NamedTuple):
    root: tuple[float, ...]
    f_root: tuple[float, ...]
    df_root: tuple[tuple[tuple[float, ...], ...], tuple[tuple[tuple[float, ...], ...], ...]]
    iters: int
    f_calls: tuple[int, int, int]
    precision: float
    error: float
    termination_reason: TerminationReason | None
    callback_code: int
    callback_stage: str | None
    linear_status: int
    linear_stage: str | None
    linear_rank: int | None

VectorHigherOrderStep = VectorChebyshevStep

class VectorChebyshev:
    def __init__(self, function: Any, jacobian: Any, hessian: Any, x0: ArrayLike,
                 f_x0: ArrayLike | None = ..., jac_x0: ArrayLike | None = ...,
                 hess_x0: ArrayLike | None = ..., *,
                 etol: SupportsFloat = ..., ertol: SupportsFloat = ...,
                 ptol: SupportsFloat = ..., prtol: SupportsFloat = ...,
                 max_iter: SupportsIndex = ..., history: SupportsIndex = ...,
                 history_every: SupportsIndex = ..., history_bytes: SupportsIndex = ...,
                 workspace_bytes: SupportsIndex = ...) -> None: ...
    def step(self) -> VectorChebyshevStep: ...
    def run(self) -> NewtonMethodsReturnType: ...
    @property
    def result(self) -> NewtonMethodsReturnType: ...
    @property
    def history(self) -> tuple[VectorChebyshevStep, ...]: ...
    @property
    def done(self) -> bool: ...
    @property
    def history_truncated(self) -> bool: ...
    @property
    def callback_code(self) -> int: ...
    @property
    def callback_stage(self) -> str | None: ...
    @property
    def linear_status(self) -> int: ...
    @property
    def linear_rank(self) -> int | None: ...
    @property
    def input_dimension(self) -> int: ...
    @property
    def output_dimension(self) -> int: ...
    @property
    def linear_stage(self) -> str | None: ...
    @property
    def method(self) -> str: ...
    def __iter__(self) -> Iterator[VectorChebyshevStep]: ...
    def __next__(self) -> VectorChebyshevStep: ...

class VectorHalley(VectorChebyshev): ...
class VectorSuperHalley(VectorChebyshev): ...

class VectorModifiedHalley(VectorChebyshev):
    def __init__(self, function: Any, jacobian: Any, hessian: Any, x0: ArrayLike,
                 f_x0: ArrayLike | None = ..., jac_x0: ArrayLike | None = ...,
                 hess_x0: ArrayLike | None = ..., *, alpha: SupportsFloat = ...,
                 etol: SupportsFloat = ..., ertol: SupportsFloat = ...,
                 ptol: SupportsFloat = ..., prtol: SupportsFloat = ...,
                 max_iter: SupportsIndex = ..., history: SupportsIndex = ...,
                 history_every: SupportsIndex = ..., history_bytes: SupportsIndex = ...,
                 workspace_bytes: SupportsIndex = ...) -> None: ...
    @property
    def alpha(self) -> float: ...

def vector_chebyshev(function: Any, jacobian: Any, hessian: Any, x0: ArrayLike, **options: Any) -> NewtonMethodsReturnType: ...
def vector_halley(function: Any, jacobian: Any, hessian: Any, x0: ArrayLike, **options: Any) -> NewtonMethodsReturnType: ...
def vector_super_halley(function: Any, jacobian: Any, hessian: Any, x0: ArrayLike, **options: Any) -> NewtonMethodsReturnType: ...
def vector_modified_halley(function: Any, jacobian: Any, hessian: Any, x0: ArrayLike, **options: Any) -> NewtonMethodsReturnType: ...
