from typing import Any, NamedTuple, SupportsFloat, SupportsIndex
from numpy.typing import ArrayLike

__all__=['JacobianVectorCallback','JacobianVectorPlan','JacobianVectorEstimate']

class JacobianVectorEstimate(NamedTuple):
    product: tuple[float, ...]
    f_calls: int
    status: str
    callback_code: int

class JacobianVectorCallback:
    def __init__(self, function: Any, input_dimension: SupportsIndex,
                 output_dimension: SupportsIndex) -> None: ...
    @classmethod
    def from_capsule(cls, capsule: Any, keepalive: Any = ...) -> JacobianVectorCallback: ...
    def evaluate(self, point: ArrayLike, direction: ArrayLike, *,
                 workspace_bytes: SupportsIndex = ...) -> tuple[float, ...]: ...
    @property
    def input_dimension(self) -> int: ...
    @property
    def output_dimension(self) -> int: ...
    @property
    def native(self) -> bool: ...

class JacobianVectorPlan:
    def __init__(self, input_dimension: SupportsIndex, output_dimension: SupportsIndex,
                 scheme: str = ..., step: SupportsFloat | None = ..., *,
                 memory_bytes: SupportsIndex = ...) -> None: ...
    def evaluate(self, function: Any, x: ArrayLike, direction: ArrayLike,
                 f_x: ArrayLike | None = ...) -> JacobianVectorEstimate: ...
    @property
    def input_dimension(self) -> int: ...
    @property
    def output_dimension(self) -> int: ...
    @property
    def scheme(self) -> str: ...
    @property
    def step(self) -> float | None: ...
    @property
    def workspace_bytes(self) -> int: ...
    @property
    def memory_bytes(self) -> int: ...
