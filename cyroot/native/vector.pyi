from collections.abc import Iterator
from typing import Any, NamedTuple, SupportsFloat, SupportsIndex
from numpy.typing import ArrayLike
from ..status import TerminationReason
from ..return_types import NewtonMethodsReturnType

class VectorNewtonStep(NamedTuple):
    root: tuple[float, ...]
    f_root: tuple[float, ...]
    df_root: tuple[tuple[float, ...], ...]
    iters: int
    f_calls: tuple[int, ...]
    precision: float
    error: float
    termination_reason: TerminationReason | None
    callback_code: int
    callback_stage: str | None
    linear_status: int
    linear_rank: int | None

class WolfeBittnerResult(NamedTuple):
    root: tuple[float, ...]
    f_root: tuple[float, ...]
    active_root: tuple[float, ...]
    active_f_root: tuple[float, ...]
    iters: int
    f_calls: int
    precision: float
    error: float
    termination_reason: TerminationReason | None
    callback_code: int
    callback_stage: str | None
    linear_status: int
    linear_rank: int | None
    affine_error: float
    @property
    def success(self) -> bool: ...
    @property
    def converged(self) -> bool: ...
    @property
    def optimal(self) -> bool: ...

WolfeBittnerStep = WolfeBittnerResult

class VectorCallback:
    def __init__(self, function: Any, dimension: SupportsIndex, *, jacobian: bool = ...) -> None: ...
    @classmethod
    def from_capsule(cls, capsule: Any, keepalive: Any = ...) -> VectorCallback: ...
    @property
    def native(self) -> bool: ...
    @property
    def dimension(self) -> int: ...
    @property
    def jacobian(self) -> bool: ...

class VectorNewton:
    def __init__(self, function: Any, jacobian: Any, x0: ArrayLike,
                 f_x0: ArrayLike | None = ..., jac_x0: ArrayLike | None = ...,
                 etol: SupportsFloat = ..., ertol: SupportsFloat = ...,
                 ptol: SupportsFloat = ..., prtol: SupportsFloat = ...,
                 max_iter: SupportsIndex = ..., history: SupportsIndex = ...,
                 history_every: SupportsIndex = ..., history_bytes: SupportsIndex = ...,
                 workspace_bytes: SupportsIndex = ...) -> None: ...
    def step(self) -> VectorNewtonStep: ...
    def run(self) -> NewtonMethodsReturnType: ...
    @property
    def result(self) -> NewtonMethodsReturnType: ...
    @property
    def history(self) -> tuple[VectorNewtonStep, ...]: ...
    @property
    def done(self) -> bool: ...
    @property
    def history_truncated(self) -> bool: ...
    @property
    def callback_code(self) -> int: ...
    @property
    def callback_stage(self) -> str | None: ...
    @property
    def linear_status(self) -> int: ...
    @property
    def linear_rank(self) -> int | None: ...
    @property
    def input_dimension(self) -> int: ...
    @property
    def output_dimension(self) -> int: ...
    def __iter__(self) -> Iterator[VectorNewtonStep]: ...
    def __next__(self) -> VectorNewtonStep: ...

class TraubSteffensen(VectorNewton):
    def __init__(self, function: Any, x0: ArrayLike, f_x0: ArrayLike | None = ..., *,
                 etol: SupportsFloat = ..., ertol: SupportsFloat = ...,
                 ptol: SupportsFloat = ..., prtol: SupportsFloat = ...,
                 max_iter: SupportsIndex = ..., history: SupportsIndex = ...,
                 history_every: SupportsIndex = ..., history_bytes: SupportsIndex = ...,
                 workspace_bytes: SupportsIndex = ...) -> None: ...

class Robinson(VectorNewton):
    def __init__(self, function: Any, x0: ArrayLike, x1: ArrayLike,
                 f_x0: ArrayLike | None = ..., f_x1: ArrayLike | None = ..., *,
                 orth: str | int = ...,
                 etol: SupportsFloat = ..., ertol: SupportsFloat = ...,
                 ptol: SupportsFloat = ..., prtol: SupportsFloat = ...,
                 max_iter: SupportsIndex = ..., history: SupportsIndex = ...,
                 history_every: SupportsIndex = ..., history_bytes: SupportsIndex = ...,
                 workspace_bytes: SupportsIndex = ...) -> None: ...

class WolfeBittner:
    def __init__(self, function: Any, x0s: ArrayLike, f_x0s: ArrayLike | None = ..., *,
                 rcond: SupportsFloat = ...,
                 etol: SupportsFloat = ..., ertol: SupportsFloat = ...,
                 ptol: SupportsFloat = ..., prtol: SupportsFloat = ...,
                 max_iter: SupportsIndex = ..., history: SupportsIndex = ...,
                 history_every: SupportsIndex = ..., history_bytes: SupportsIndex = ...,
                 workspace_bytes: SupportsIndex = ...) -> None: ...
    def step(self) -> WolfeBittnerResult: ...
    def run(self) -> WolfeBittnerResult: ...
    @property
    def result(self) -> WolfeBittnerResult: ...
    @property
    def history(self) -> tuple[WolfeBittnerResult, ...]: ...
    @property
    def done(self) -> bool: ...
    @property
    def history_truncated(self) -> bool: ...
    @property
    def input_dimension(self) -> int: ...
    @property
    def output_dimension(self) -> int: ...
    @property
    def point_count(self) -> int: ...
    @property
    def linear_status(self) -> int: ...
    @property
    def linear_rank(self) -> int | None: ...
    @property
    def callback_code(self) -> int: ...
    @property
    def callback_stage(self) -> str | None: ...
    def __iter__(self) -> Iterator[WolfeBittnerResult]: ...
    def __next__(self) -> WolfeBittnerResult: ...

def vector_newton(function: Any, jacobian: Any, x0: ArrayLike, **options: Any) -> NewtonMethodsReturnType: ...
def robinson(function: Any, x0: ArrayLike, x1: ArrayLike, **options: Any) -> NewtonMethodsReturnType: ...
def traub_steffensen(function: Any, x0: ArrayLike, **options: Any) -> NewtonMethodsReturnType: ...
def wolfe_bittner(function: Any, x0s: ArrayLike, **options: Any) -> WolfeBittnerResult: ...
